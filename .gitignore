.npm
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.pnp.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Next.js ──────────────────────────────────────────────────
apps/web/.next/
apps/web/out/
apps/web/.turbo/
apps/web/next-env.d.ts

# ── Environment / Secrets ────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example
!.env.example

# ── Supabase ─────────────────────────────────────────────────
