.idea/modules
*.hprof
.cxx/
build/
captures/
.DS_Store
**/.DS_Store
*.apk
*.ap_
*.aab
*.dex
gen/
out/
bin/
proguard/
release/
gradle-app.setting
!gradle-wrapper.jar
.gradletasknamecache
**/local.properties

# ── Kotlin / Java ────────────────────────────────────────────
*.class
*.log
*.jar
*.war
*.ear
*.nar

# ── Node / npm / yarn / pnpm ─────────────────────────────────
